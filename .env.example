# Application
APP_NAME=SmartCityAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
MYSQL_ROOT_PASSWORD=change_me_locally
MYSQL_DATABASE=smartcity_db
MYSQL_USER=smartcity_user
MYSQL_PASSWORD=change_me_locally
DATABASE_URL=mysql+pymysql://smartcity_user:change_me_locally@localhost:3306/smartcity_db

# Authentication
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider - configure only if required
AI_API_KEY=
AI_MODEL=

# Frontend API
API_BASE_URL=http://localhost:8000/api/v1
